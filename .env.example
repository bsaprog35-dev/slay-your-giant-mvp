# Copy to .env for local use. Never commit real keys.
# (Existing keys used by /api/chat and /api/voice are set in Vercel / your local .env.)

# --- "Slay Your Giant in 7 Days" funnel ---
RESEND_API_KEY=
# Optional override; the domain must be verified in Resend. Leave blank to use the defaults.
RESEND_FROM_EMAIL=
# Where coaching/workshop lead alerts go (Dr. Ben's inbox)
DR_BEN_EMAIL=
# Optional: webhook (Zapier/Make/Sheets) that receives each lead as JSON
LEAD_WEBHOOK_URL=
